---
import "../styles/global.css";
import IconSprite from "../components/icons/IconSprite.astro";
import { SITE } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = `${SITE.name} — ${SITE.tagline}`,
  description = "90 reference cards across UI, UX, accessibility, and more. Built for non-developer vibe coders who want to ship good software.",
  image = "/images/logo.svg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || SITE.url);
const imageURL = new URL(image, Astro.site || SITE.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:site_name" content={SITE.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#12101f" />

    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8GNL26RQDM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-8GNL26RQDM');
    </script>

    <link
      href="https://api.fontshare.com/v2/css?f[]=clash-grotesk@400,500,600,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <IconSprite />
    <slot />
  </body>
</html>
