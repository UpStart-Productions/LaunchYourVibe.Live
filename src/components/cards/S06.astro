---
import UxCard from "../UxCard.astro";
import { Check, X } from "lucide-astro";
---

<UxCard
  id="S-06"
  domain="Security"
  domainClass="s-s"
  title=`Parameterize<br/>Every Query.`
  rule=`<strong>Raw string concatenation in queries is how SQL injection happens.</strong> Parameterized queries are non-negotiable — let the database engine separate data from instructions.`
>
<div class="fc-5 s06-visual">
<div class="vis-box-bad-sm2">
<div class="vis-label-bad-sm"><X size={13} class="ux-icon" /> String concat</div>
<div class="code-block" style="padding:5px 7px;line-height:1.6;">"... WHERE id = '" + input</div>
<div class="text-red-bold" style="font-size:11px;margin-top:4px;">'; DROP TABLE users;--</div>
</div>
<div class="vis-box-good-sm2">
<div class="vis-label-good-sm"><Check size={13} class="ux-icon" /> Prepared statement</div>
<div class="code-block" style="padding:5px 7px;line-height:1.6;">WHERE id = $1</div>
<div class="text-7-mid-mt">Input treated as data, not code</div>
</div>
</div>
</UxCard>
