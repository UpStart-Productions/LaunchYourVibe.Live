---
import UxCard from "../UxCard.astro";
---

<UxCard
  id="T-02"
  domain="Spacing & Typography"
  domainClass="d-t"
  title=`The 8pt Grid:<br/>Your Spacing Foundation`
  rule=`<strong>Arbitrary spacing makes screens feel unsteady.</strong> When everything snaps to the grid, the spacing becomes invisible, which is the goal.`
>
<div class="space-scale t02-visual">
  <div class="space-row"><div class="space-box" style="width:4px;opacity:0.25;"></div><span class="space-label">4px</span><span class="space-name">Micro: icon gaps, badge offsets</span></div>
  <div class="space-row"><div class="space-box" style="width:8px;opacity:0.4;"></div><span class="space-label">8px</span><span class="space-name">Tight: within components</span></div>
  <div class="space-row"><div class="space-box" style="width:16px;opacity:0.55;"></div><span class="space-label">16px</span><span class="space-name">Default: padding, row gaps</span></div>
  <div class="space-row"><div class="space-box" style="width:24px;opacity:0.7;"></div><span class="space-label">24px</span><span class="space-name">Comfortable: section gaps</span></div>
  <div class="space-row"><div class="space-box" style="width:32px;opacity:0.85;"></div><span class="space-label">32px</span><span class="space-name">Loose: page sections</span></div>
  <div class="space-row"><div class="space-box" style="width:48px;opacity:1;"></div><span class="space-label">48px</span><span class="space-name">Open: major layout gaps</span></div>
</div>
</UxCard>
