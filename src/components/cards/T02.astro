---
import UxCard from "../UxCard.astro";
---

<UxCard
  id="T-02"
  domain="Spacing & Typography"
  domainClass="d-t"
  title=`The 8pt Grid:<br/>Spacing in rem`
  rule=`<strong>Arbitrary spacing makes screens feel unsteady.</strong> Snap component gaps and padding to rem (0.25rem steps on an 8pt grid). For page-level breathing room, use vw in clamp() so gutters grow with the viewport.`
>
  <div class="space-scale t02-visual">
    <div class="space-step">
      <div class="space-step-label"><strong>0.25rem</strong> icon gaps, badge offsets</div>
      <div class="space-gap-row" style="--space-gap: 0.25rem">
        <span class="space-gap-box"></span>
        <span class="space-gap-box"></span>
        <span class="space-gap-box"></span>
        <span class="space-gap-box"></span>
      </div>
    </div>
    <div class="space-step">
      <div class="space-step-label"><strong>0.5rem</strong> within components</div>
      <div class="space-gap-row" style="--space-gap: 0.5rem">
        <span class="space-gap-box"></span>
        <span class="space-gap-box"></span>
        <span class="space-gap-box"></span>
        <span class="space-gap-box"></span>
      </div>
    </div>
    <div class="space-step">
      <div class="space-step-label"><strong>1rem</strong> padding, row gaps</div>
      <div class="space-gap-row" style="--space-gap: 1rem">
        <span class="space-gap-box"></span>
        <span class="space-gap-box"></span>
        <span class="space-gap-box"></span>
        <span class="space-gap-box"></span>
      </div>
    </div>
    <div class="space-step">
      <div class="space-step-label"><strong>1.5rem</strong> section gaps</div>
      <div class="space-gap-row" style="--space-gap: 1.5rem">
        <span class="space-gap-box"></span>
        <span class="space-gap-box"></span>
        <span class="space-gap-box"></span>
        <span class="space-gap-box"></span>
      </div>
    </div>
    <div class="space-step">
      <div class="space-step-label"><strong>2rem</strong> page sections</div>
      <div class="space-gap-row" style="--space-gap: 2rem">
        <span class="space-gap-box"></span>
        <span class="space-gap-box"></span>
        <span class="space-gap-box"></span>
        <span class="space-gap-box"></span>
      </div>
    </div>
    <div class="space-step">
      <div class="space-step-label"><strong>3rem</strong> major layout gaps</div>
      <div class="space-gap-row" style="--space-gap: 3rem">
        <span class="space-gap-box"></span>
        <span class="space-gap-box"></span>
        <span class="space-gap-box"></span>
        <span class="space-gap-box"></span>
      </div>
    </div>
  </div>
</UxCard>
