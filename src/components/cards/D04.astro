---
import UxCard from "../UxCard.astro";
import Icon from "../icons/Icon.astro";
---

<UxCard
  id="D-04"
  domain="Data"
  domainClass="d-d"
  title=`Axis Labels and Units<br/>Must Always Be Visible`
  rule=`<strong>A chart without axis labels is a Rorschach test.</strong> Every axis needs a label and a unit. "Revenue" without "$" or "K" forces users to guess the scale. Never rely on tooltips alone: they're invisible on mobile and require interaction to reveal basic context.`
>
<div class="fr-5 d04-visual">
<div class="verdict-col">
<span class="verdict-label label-good"><Icon name="Check" size={13} class="ux-icon" /> Labeled</span>
<div class="flex-box-good">
<svg viewbox="0 0 55 40" width="100%">
<line stroke="#DDD" stroke-width="1" x1="12" x2="12" y1="5" y2="35"></line>
<line stroke="#DDD" stroke-width="1" x1="12" x2="52" y1="35" y2="35"></line>
<text fill="#666" font-size="3.5" text-anchor="middle" transform="rotate(-90 5 20)" x="5" y="20">$K</text>
<text fill="#666" font-size="3.5" text-anchor="middle" x="32" y="39">Month</text>
<polyline fill="none" points="12,30 22,18 32,22 42,10 52,14" stroke="#B81800" stroke-width="1.5"></polyline>
</svg>
</div>
</div>
<div class="verdict-col">
<span class="verdict-label label-bad"><Icon name="X" size={13} class="ux-icon" /> No context</span>
<div class="flex-box-bad">
<svg viewbox="0 0 55 40" width="100%">
<line stroke="#DDD" stroke-width="1" x1="8" x2="8" y1="5" y2="35"></line>
<line stroke="#DDD" stroke-width="1" x1="8" x2="52" y1="35" y2="35"></line>
<polyline fill="none" points="8,30 20,18 32,22 44,10 52,14" stroke="#E57373" stroke-width="1.5"></polyline>
<text fill="#AAA" font-size="4" text-anchor="middle" x="28" y="39">Month</text>
</svg>
<div class="text-6-5-aa">Values 0–? Unknown</div>
</div>
</div>
</div>
</UxCard>
