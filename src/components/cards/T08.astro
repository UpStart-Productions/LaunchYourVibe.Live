---
import UxCard from "../UxCard.astro";
import Icon from "../icons/Icon.astro";
---

<UxCard
  id="T-08"
  domain="Spacing & Typography"
  domainClass="d-t"
  title=`Whitespace Is<br/>a Design Element`
  rule=`<strong>Space is not empty: it's structure.</strong> Generous spacing reduces cognitive load. The gaps between elements tell users which things belong together and what's a separate thought.`
>
<div class="bad-good-row t08-visual">
<div class="verdict-col">
<span class="verdict-label label-bad"><Icon name="X" size={13} class="ux-icon" /> Cramped</span>
<div class="vis-demo-bg" style="padding:4px;display:flex;flex-direction:column;gap:1px;">
<div class="bar-ddd" style="height:7px;"></div>
<div class="bar-5-gray"></div>
<div class="bar-5-gray"></div>
<div class="bar-5-gray"></div>
<div class="bar-gray-input" style="height:12px;margin-top:2px;"></div>
<div class="bar-5-gray"></div>
<div class="bar-5-gray"></div>
<div class="bar-gray-input" style="height:12px;margin-top:1px;"></div>
</div>
</div>
<div class="verdict-col">
<span class="verdict-label label-good"><Icon name="Check" size={13} class="ux-icon" /> Breathes</span>
<div class="vis-demo-bg" style="padding:7px;display:flex;flex-direction:column;">
<div class="bar-gray-dark" style="height:7px;margin-bottom:6px;"></div>
<div class="bar-4-mb3"></div>
<div class="bar-4-light" style="margin-bottom:10px;"></div>
<div class="bar-gray-dark" style="height:12px;border-radius:3px;margin-bottom:8px;"></div>
<div class="bar-4-mb3"></div>
<div class="bar-4-light"></div>
</div>
</div>
</div>
</UxCard>
