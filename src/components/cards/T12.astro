---
import UxCard from "../UxCard.astro";
---

<UxCard
  id="T-12"
  domain="Spacing & Typography"
  domainClass="d-t"
  title=`Letter Spacing:<br/>Where It Helps`
  rule=`<strong>Tight letter spacing on big type is a design move. Tight spacing on small type is illegible.</strong> The smaller the text, the more spacing it needs: not less. Never tighten body text.`
>
<div class="fc-5 t12-visual">
<div class="label-row"><span class="text-label-blue">LABELS &amp; TAGS</span><span class="val text-blue">+0.08 - 0.15em</span></div>
<div class="label-row"><span class="text-h1-tight">Large Headlines</span><span class="val text-blue">−0.01 - 0.02em</span></div>
<div class="label-row"><span class="text-body-normal">Body paragraph text</span><span class="val text-blue">0 (default)</span></div>
<div class="label-row"><span class="mono-letterspacing">Code / mono</span><span class="val text-blue">+0.03 - 0.05em</span></div>
</div>
</UxCard>