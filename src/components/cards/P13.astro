---
import UxCard from "../UxCard.astro";
---

<UxCard
  id="P-13"
  domain="Privacy"
  domainClass="p-p"
  title=`Third Parties Belong<br/>in Your Policy.`
  rule=`<strong>Disclose what you share.</strong> If data touches a third party — analytics, payment processor, email provider — your privacy policy says so explicitly. Name them, name the data, name the purpose.`
>
<div class="fc-5 p13-visual">
<div class="vis-box-neutral">
<div class="vis-label-muted-sm">We share data with:</div>
<div class="fc-3" style="margin-top:4px;">
<div class="label-row"><span>Stripe</span><span class="val">payment info</span></div>
<div class="label-row"><span>Postmark</span><span class="val">email address</span></div>
<div class="label-row"><span>Google Analytics</span><span class="val">usage data</span></div>
</div>
</div>
<div class="text-xxs-muted-mt">Named · purpose stated · linked in policy</div>
</div>
</UxCard>
