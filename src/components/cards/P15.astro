---
import UxCard from "../UxCard.astro";
---

<UxCard
  id="P-15"
  domain="Privacy"
  domainClass="p-p"
  title=`Know Who to Notify<br/>Before It Happens.`
  rule=`<strong>Breach plan before you need one.</strong> Know who you'd notify, in what order, within what timeframe. Figuring it out during an incident is too late.`
>
<div class="fc-5 p15-visual">
<div class="vis-box-neutral">
<div class="vis-label-muted-sm">Incident response order</div>
<div class="check-list check-list-sm" style="margin-top:4px;">
<div class="check-item"><span class="pill pill-red" style="font-size:9px;">1</span> Contain &amp; rotate keys</div>
<div class="check-item"><span class="pill pill-amber" style="font-size:9px;">2</span> Notify legal counsel</div>
<div class="check-item"><span class="pill pill-amber" style="font-size:9px;">3</span> Notify affected users (72h)</div>
<div class="check-item"><span class="pill pill-gray" style="font-size:9px;">4</span> Regulators if required</div>
</div>
</div>
<div class="text-xxs-center">Written before launch · rehearsed annually</div>
</div>
</UxCard>
