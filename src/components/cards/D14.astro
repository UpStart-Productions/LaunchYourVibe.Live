---
import UxCard from "../UxCard.astro";
---

<UxCard
  id="D-14"
  domain="Data"
  domainClass="d-d"
  title=`Layer Data: Summary<br/>First, Detail on Demand`
  rule=`<strong>Most users want the headline; a few want the footnotes.</strong> Lead with the single most important number and its trend. Let users drill into breakdown views only if they choose. Showing everything at once creates dashboards that exhaust instead of inform.`
>
<div class="fc-4 d14-visual">
<div class="kpi-hero">
<div class="kpi-big">$48K</div>
<div style="flex:1;">
<div class="text-8-semibold">Monthly Revenue</div>
<div class="text-trend-up">↑ 12% vs last month</div>
</div>
<svg height="20" viewbox="0 0 40 20" width="40"><polyline fill="none" points="2,15 10,11 18,13 26,6 34,8 38,4" stroke="#B81800" stroke-linecap="round" stroke-width="1.5"></polyline></svg>
</div>
<div class="text-xxs-center">Tap → breakdown by product / region / channel</div>
<div class="fr-3">
<div class="flex-box-bad-xs"><div class="text-brown-xs">Product A</div><div class="text-sm-bold">$22K</div></div>
<div class="flex-box-bad-xs"><div class="text-brown-xs">Product B</div><div class="text-sm-bold">$18K</div></div>
<div class="flex-box-bad-xs"><div class="text-brown-xs">Other</div><div class="text-sm-bold">$8K</div></div>
</div>
</div>
</UxCard>