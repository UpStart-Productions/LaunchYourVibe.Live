---
import UxCard from "../UxCard.astro";
import { Check, X } from "lucide-astro";
---

<UxCard
  id="P-05"
  domain="Privacy"
  domainClass="p-p"
  title=`Logs Are<br/>a Liability Too.`
  rule=`<strong>Don't log what you don't need.</strong> Full user-agents, IP addresses, raw request bodies — if you're not actively using it, don't keep it. Logs are a liability too.`
>
<div class="fc-5 p05-visual">
<div class="vis-box-bad-sm2">
<div class="vis-label-bad-sm"><X size={13} class="ux-icon" /> Over-logging</div>
<div class="code-block" style="padding:5px 7px;line-height:1.5;font-size:10px;">IP, UA, body, cookies,<br/>auth headers…</div>
</div>
<div class="vis-box-good-sm2">
<div class="vis-label-good-sm"><Check size={13} class="ux-icon" /> Need-to-know only</div>
<div class="code-block" style="padding:5px 7px;line-height:1.5;font-size:10px;">request_id, status,<br/>duration_ms</div>
</div>
</div>
</UxCard>
