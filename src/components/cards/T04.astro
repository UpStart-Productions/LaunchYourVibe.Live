---
import UxCard from "../UxCard.astro";
---

<UxCard
  id="T-04"
  domain="Spacing & Typography"
  domainClass="d-t"
  title=`Weight Does the<br/>Hierarchy Work`
  rule=`<strong>Color and size aren't the only tools.</strong> Weight creates hierarchy even in a single color. Use 400 for body, 600 for labels, 700 for headings: avoid everything in between.`
>
<div class="typo-demo t04-visual">
<div class="typo-title">Page Title</div>
<div class="typo-sub">Section heading</div>
<div class="typo-body">Body text reads here at regular weight. The eye moves through hierarchy without friction.</div>
<div class="typo-cap">Caption · secondary info</div>
</div>
</UxCard>
