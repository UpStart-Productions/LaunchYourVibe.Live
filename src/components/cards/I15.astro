---
import UxCard from "../UxCard.astro";
---

<UxCard
  id="I-15"
  domain="Interaction"
  domainClass="d-i"
  title=`Right Keyboard<br/>for Every Input`
  rule=`<strong>The wrong keyboard is a tiny betrayal of trust.</strong> A number pad for phone numbers, @ key for emails: set inputmode or type correctly and the keyboard is already optimized.`
>
<div class="fc-4 i15-visual">
<div class="label-row"><span>Phone number</span><span class="val text-orange-mono">tel</span></div>
<div class="label-row"><span>Email address</span><span class="val text-orange-mono">email</span></div>
<div class="label-row"><span>URL / web address</span><span class="val text-orange-mono">url</span></div>
<div class="label-row"><span>Whole numbers</span><span class="val text-orange-mono">numeric</span></div>
<div class="label-row"><span>Decimals / prices</span><span class="val text-orange-mono">decimal</span></div>
<div class="label-row"><span>Search field</span><span class="val text-orange-mono">search</span></div>
</div>
</UxCard>