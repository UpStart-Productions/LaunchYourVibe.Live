---
import UxCard from "../UxCard.astro";
import Icon from "../icons/Icon.astro";
---

<UxCard
  id="P-08"
  domain="Privacy"
  domainClass="p-p"
  title=`Never Plain Text<br/>in a Column.`
  rule=`<strong>Sensitive fields get encrypted or hashed at rest.</strong> Passwords, tokens, anything personally identifiable — hashed or encrypted at rest. Never plain text in a column.`
>
<div class="fc-5 p08-visual">
<div class="verdict-col">
<span class="verdict-label label-good"><Icon name="Check" size={13} class="ux-icon" /> Hashed at rest</span>
<div class="vis-box-good-sm2">
<div class="code-block" style="padding:5px 7px;font-size:10px;">$2b$12$K8x…9mZ</div>
</div>
</div>
<div class="verdict-col">
<span class="verdict-label label-bad"><Icon name="X" size={13} class="ux-icon" /> Plain text column</span>
<div class="vis-box-bad-sm2">
<div class="code-block" style="padding:5px 7px;">password: "hunter2"</div>
</div>
</div>
</div>
</UxCard>
