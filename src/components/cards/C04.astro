---
import UxCard from "../UxCard.astro";
import Icon from "../icons/Icon.astro";
---

<UxCard
  id="C-04"
  domain="Components"
  domainClass="d-c"
  title=`Toggle = Immediate.<br/>Checkbox = On Submit.`
  rule=`<strong>Toggles are instant actions. Checkboxes are selection within a form.</strong> If the setting takes effect the moment you flip it (like dark mode), use a toggle. If it's part of a group submitted together, use checkboxes.`
>
<div class="fc-5 c04-visual">
<div class="vis-box">
<div class="mono-toggle-lbl">Toggle: takes effect now</div>
<div class="fr-between">
<div class="label-dark-sm">Dark Mode</div>
<div class="toggle-on"><div class="toggle-knob"></div></div>
</div>
</div>
<div class="vis-box">
<div class="mono-checkbox-lbl">Checkbox: applied when saved</div>
<div class="fc-4">
<div class="fr-c6-lg"><div class="checkbox-on"><span class="check-white"><Icon name="Check" size={13} class="ux-icon" /></span></div>Marketing emails</div>
<div class="fr-c6-lg"><div class="checkbox-off"></div>Security alerts</div>
</div>
</div>
</div>
</UxCard>