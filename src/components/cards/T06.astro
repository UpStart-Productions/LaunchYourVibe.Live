---
import UxCard from "../UxCard.astro";
---

<UxCard
  id="T-06"
  domain="Spacing & Typography"
  domainClass="d-t"
  title=`Padding vs Margin:<br/>Inside vs Outside`
  rule=`<strong>Padding changes the element's feel; margin changes its relationship to neighbors.</strong> Use padding to make a button feel spacious. Use margin to create breathing room in a layout.`
>
<div class="pad-margin-wrap t06-visual">
<div class="pad-margin-outer">
<div class="mono-margin-lbl">MARGIN (outside)</div>
<div class="pad-margin-inner">
<div class="mono-padding-lbl">PADDING (inside)</div>
<div class="btn-blue-demo">Content</div>
</div>
</div>
</div>
</UxCard>
