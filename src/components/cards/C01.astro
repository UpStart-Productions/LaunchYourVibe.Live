---
import UxCard from "../UxCard.astro";
import { Monitor, Smartphone } from "lucide-astro";
---

<UxCard
  id="C-01"
  domain="Components"
  domainClass="d-c"
  title=`Modal → Desktop<br/>Bottom Sheet → Mobile`
  rule=`<strong>Modals trap thumbs.</strong> On mobile, a centered dialog requires two-handed use. A bottom sheet rises from where thumbs already live. Same intent. Opposite ergonomics.`
>
<div class="comp-compare c01-visual">
<div class="comp-col">
<div class="comp-platform"><Monitor size={14} class="ux-icon" /> Desktop</div>
<div class="modal-demo">
<div class="modal-box">
<div class="modal-titlebar"></div>
<div class="modal-body-line" style="width:90%"></div>
<div class="modal-body-line" style="width:72%"></div>
<div class="modal-btn-row"><div class="modal-btn-mini modal-btn-cancel"></div><div class="modal-btn-mini modal-btn-ok"></div></div>
</div>
</div>
</div>
<div class="divider-v"></div>
<div class="comp-col">
<div class="comp-platform"><Smartphone size={14} class="ux-icon" /> Mobile</div>
<div class="sheet-demo">
<div class="bottom-sheet">
<div class="sheet-handle"></div>
<div class="sheet-option"></div>
<div class="sheet-option"></div>
<div class="sheet-option" style="margin-bottom:0"></div>
</div>
</div>
</div>
</div>
</UxCard>
