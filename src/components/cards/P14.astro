---
import UxCard from "../UxCard.astro";
import Icon from "../icons/Icon.astro";
---

<UxCard
  id="P-14"
  domain="Privacy"
  domainClass="p-p"
  title=`Export, Correct,<br/>and Delete.`
  rule=`<strong>Give users control over their data.</strong> Export, correction, and deletion aren't just legal requirements in some jurisdictions. They're what trustworthy products do.`
>
<div class="fc-5 p14-visual">
<div class="vis-box-neutral">
<div class="vis-label-muted-sm">Account settings</div>
<div class="fr-5" style="margin-top:5px;justify-content:center;">
<div class="flex-box-good-sq" style="text-align:center;padding:8px 6px;">
<Icon name="Download" size={14} class="ux-icon" />
<div class="text-xxs-gray" style="margin-top:3px;">Export</div>
</div>
<div class="flex-box-good-sq" style="text-align:center;padding:8px 6px;">
<Icon name="Pencil" size={14} class="ux-icon" />
<div class="text-xxs-gray" style="margin-top:3px;">Correct</div>
</div>
<div class="flex-box-good-sq" style="text-align:center;padding:8px 6px;">
<Icon name="Trash2" size={14} class="ux-icon" />
<div class="text-xxs-gray" style="margin-top:3px;">Delete</div>
</div>
</div>
</div>
</div>
</UxCard>
