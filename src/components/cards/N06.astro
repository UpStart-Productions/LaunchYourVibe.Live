---
import UxCard from "../UxCard.astro";
import Icon from "../icons/Icon.astro";
---

<UxCard
  id="N-06"
  domain="Navigation"
  domainClass="d-n"
  title=`Tab Bar: 3–5 Items.<br/>No More.`
  rule=`<strong>Beyond 5 tabs, labels disappear and icons carry everything.</strong> If you have 6+ destinations, restructure the IA: nest them, or use a different nav pattern. Tab bars are for top-level, equal-weight destinations.`
>
<div class="fc-6 n06-visual">
<div class="verdict-col">
<span class="verdict-label label-good"><Icon name="Check" size={13} class="ux-icon" /> 4 items: clear, usable</span>
<div class="tab-good-wrap">
<div class="fr-around">
<div class="fc-center-1"><span class="text-2xl"><Icon name="House" size={16} class="ux-icon" /></span><span class="tab-active-lbl">Home</span></div>
<div class="fc-center-1"><span class="text-2xl"><Icon name="Search" size={16} class="ux-icon" /></span><span class="text-xs-faded">Search</span></div>
<div class="fc-center-1"><span class="text-2xl"><Icon name="Bell" size={16} class="ux-icon" /></span><span class="text-xs-faded">Alerts</span></div>
<div class="fc-center-1"><span class="text-2xl"><Icon name="User" size={16} class="ux-icon" /></span><span class="text-xs-faded">Profile</span></div>
</div>
</div>
</div>
<div class="verdict-col">
<span class="verdict-label label-bad"><Icon name="X" size={13} class="ux-icon" /> 7 items: crammed, confusing</span>
<div class="tab-bad-wrap">
<div class="fr-around">
<span class="text-md-faded"><Icon name="House" size={16} class="ux-icon" /></span><span class="text-md-faded"><Icon name="Search" size={16} class="ux-icon" /></span><span class="text-md-faded"><Icon name="Plus" size={16} class="ux-icon" /></span><span class="text-md-faded"><Icon name="Bell" size={16} class="ux-icon" /></span><span class="text-md-faded"><Icon name="MessageSquare" size={16} class="ux-icon" /></span><span class="text-md-faded"><Icon name="Calendar" size={16} class="ux-icon" /></span><span class="text-md-faded"><Icon name="User" size={16} class="ux-icon" /></span>
</div>
</div>
</div>
</div>
</UxCard>
