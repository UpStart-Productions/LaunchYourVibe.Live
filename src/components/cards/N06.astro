---
import UxCard from "../UxCard.astro";
import { Bell, Calendar, Check, House, MessageSquare, Plus, Search, User, X } from "lucide-astro";
---

<UxCard
  id="N-06"
  domain="Navigation"
  domainClass="d-n"
  title=`Tab Bar: 3–5 Items.<br/>No More.`
  rule=`<strong>Beyond 5 tabs, labels disappear and icons carry everything.</strong> If you have 6+ destinations, restructure the IA: nest them, or use a different nav pattern. Tab bars are for top-level, equal-weight destinations.`
>
<div class="fc-6 n06-visual">
<div class="tab-good-wrap">
<div class="vis-label-good-lg"><Check size={13} class="ux-icon" /> 4 items: clear, usable</div>
<div class="fr-around">
<div class="fc-center-1"><span class="text-2xl"><House size={16} class="ux-icon" /></span><span class="tab-active-lbl">Home</span></div>
<div class="fc-center-1"><span class="text-2xl"><Search size={16} class="ux-icon" /></span><span class="text-xs-muted">Search</span></div>
<div class="fc-center-1"><span class="text-2xl"><Bell size={16} class="ux-icon" /></span><span class="text-xs-muted">Alerts</span></div>
<div class="fc-center-1"><span class="text-2xl"><User size={16} class="ux-icon" /></span><span class="text-xs-muted">Profile</span></div>
</div>
</div>
<div class="tab-bad-wrap">
<div class="mono-bad-tab-hd"><X size={13} class="ux-icon" /> 7 items: crammed, confusing</div>
<div class="fr-around">
<span class="text-md-faded"><House size={16} class="ux-icon" /></span><span class="text-md-faded"><Search size={16} class="ux-icon" /></span><span class="text-md-faded"><Plus size={16} class="ux-icon" /></span><span class="text-md-faded"><Bell size={16} class="ux-icon" /></span><span class="text-md-faded"><MessageSquare size={16} class="ux-icon" /></span><span class="text-md-faded"><Calendar size={16} class="ux-icon" /></span><span class="text-md-faded"><User size={16} class="ux-icon" /></span>
</div>
</div>
</div>
</UxCard>