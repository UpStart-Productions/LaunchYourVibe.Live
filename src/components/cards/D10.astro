---
import UxCard from "../UxCard.astro";
import Icon from "../icons/Icon.astro";
---

<UxCard
  id="D-10"
  domain="Data"
  domainClass="d-d"
  title=`Chart Tooltips: Detail<br/>on Demand`
  rule=`<strong>Tooltips layer precise values onto a chart without cluttering it.</strong> Don't rely on them as the only access to important data: mobile users must tap to trigger them, and they're invisible until interaction. Design for the chart to communicate its core message without tooltip dependency.`
>
<div class="fc-5 d10-visual">
<div class="vis-box-f5" style="position:relative;">
<svg viewbox="0 0 120 45" width="100%">
<line stroke="#DDD" stroke-width="1" x1="10" x2="10" y1="5" y2="40"></line>
<line stroke="#DDD" stroke-width="1" x1="10" x2="115" y1="40" y2="40"></line>
<polyline fill="none" points="10,35 30,25 50,28 70,12 90,18 110,8" stroke="#B81800" stroke-linecap="round" stroke-width="1.5"></polyline>
<circle cx="70" cy="12" fill="#B81800" r="3"></circle>
<rect fill="white" height="14" rx="2" stroke="#B81800" stroke-width="0.8" width="40" x="55" y="2"></rect>
<text fill="#333" font-size="3.5" font-weight="bold" text-anchor="middle" x="75" y="8">Apr 2024</text>
<text fill="#B81800" font-size="3.5" text-anchor="middle" x="75" y="13">$24,100</text>
</svg>
<div class="text-xxs-center">Hover/tap → precise value</div>
</div>
<div class="vis-label-bad-cap"><Icon name="TriangleAlert" size={13} class="ux-icon" /> Tooltips don't exist on mobile without tap</div>
</div>
</UxCard>