---
import UxCard from "../UxCard.astro";
---

<UxCard
  id="C-05"
  domain="Components"
  domainClass="d-c"
  title=`Cards for Browse.<br/>Lists for Scan.`
  rule=`<strong>Cards invite exploration; lists support comparison.</strong> Use cards when each item has rich media or requires its own visual weight. Use lists when users are scanning for a specific item quickly.`
>
<div class="comp-compare c05-visual">
<div class="comp-col">
<div class="comp-platform">Cards</div>
<div class="vis-browse-col" style="gap:4px;">
<div class="vis-card">
<div class="card-img-good" style="height:28px;margin-bottom:4px;"></div>
<div class="bar-4-faint-mb"></div>
<div class="bar-4-faint" style="width:70%;"></div>
</div>
<div class="vis-card">
<div class="card-img-info" style="height:28px;margin-bottom:4px;"></div>
<div class="bar-4-faint-mb"></div>
<div class="bar-4-faint" style="width:80%;"></div>
</div>
</div>
</div>
<div class="divider-v"></div>
<div class="comp-col">
<div class="comp-platform">Lists</div>
<div class="vis-browse-col" style="gap:2px;">
<div class="vis-chip"><div class="dot-green"></div><div class="bar-fill-5"></div></div>
<div class="vis-chip"><div class="dot-green"></div><div class="bar-fill-5"></div></div>
<div class="vis-chip"><div class="dot-green"></div><div class="bar-fill-5"></div></div>
<div class="vis-chip"><div class="dot-green"></div><div class="bar-fill-5"></div></div>
</div>
</div>
</div>
</UxCard>