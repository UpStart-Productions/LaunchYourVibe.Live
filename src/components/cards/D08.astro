---
import UxCard from "../UxCard.astro";
---

<UxCard
  id="D-08"
  domain="Data"
  domainClass="d-d"
  title=`Sparklines: Trend<br/>at a Glance`
  rule=`<strong>Sparklines pack trend context into a single row.</strong> They're not for precise reading: they're for direction and shape at a glance. Pair them with a KPI value. Omit axis labels; the shape is the message. Perfect for dashboards with many metrics in limited space.`
>
<div class="fc-4 d08-visual">
<div class="vis-box-neutral">
<div class="fc-4">
<div class="fr-between">
<div class="text-8-semibold">Revenue</div>
<div class="text-lg-green">$48.2K</div>
<svg height="20" viewbox="0 0 50 20" width="50"><polyline fill="none" points="2,16 10,12 18,14 26,6 34,8 42,4 48,2" stroke="#B81800" stroke-linecap="round" stroke-width="1.5"></polyline></svg>
</div>
<div class="fr-between">
<div class="text-8-semibold">Users</div>
<div class="text-lg-green">1,204</div>
<svg height="20" viewbox="0 0 50 20" width="50"><polyline fill="none" points="2,14 10,10 18,16 26,8 34,12 42,6 48,9" stroke="#B81800" stroke-linecap="round" stroke-width="1.5"></polyline></svg>
</div>
<div class="fr-between">
<div class="text-8-semibold">Churn</div>
<div class="text-kpi-bad">3.1%</div>
<svg height="20" viewbox="0 0 50 20" width="50"><polyline fill="none" points="2,6 10,8 18,4 26,10 34,6 42,12 48,16" stroke="#E57373" stroke-linecap="round" stroke-width="1.5"></polyline></svg>
</div>
</div>
</div>
</div>
</UxCard>