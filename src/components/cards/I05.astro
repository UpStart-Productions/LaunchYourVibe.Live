---
import UxCard from "../UxCard.astro";
---

<UxCard
  id="I-05"
  domain="Interaction"
  domainClass="d-i"
  title=`Success Is a<br/>Moment. Mark It.`
  rule=`<strong>Silence after a successful action breeds doubt.</strong> Confirm what happened, to whom, and what comes next. The user's mental model needs closure.`
>
<div class="fc-center-6 i05-visual">
<div class="success-icon-wrap i05-success-circle">
<svg class="i05-check-draw" viewBox="0 0 24 24" aria-hidden="true">
<path pathLength="24" d="M20 6 9 17l-5-5" />
</svg>
</div>
<div class="text-success-heading">Payment Sent</div>
<div class="text-success-body">$240.00 to Sarah Johnson<br/>arrives in 1–2 business days</div>
<div class="btn-receipt i05-receipt-btn">View Receipt →</div>
</div>
</UxCard>