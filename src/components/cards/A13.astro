---
import UxCard from "../UxCard.astro";
import Icon from "../icons/Icon.astro";
---

<UxCard
  id="A-13"
  domain="Accessibility"
  domainClass="a-a"
  title=`DOM Order = Reading<br/>Order`
  rule=`<strong>Screen readers follow the DOM: not what's visible on screen.</strong> Using CSS <code>order</code>, <code>float</code>, or absolute positioning to rearrange visuals without reordering HTML creates a disjointed reading experience for keyboard and screen reader users.`
>
<div class="fr-5 a13-visual">
<div class="verdict-col">
<span class="verdict-label label-good"><Icon name="Check" size={13} class="ux-icon" /> Logical DOM</span>
<div class="flex-box-good">
<div class="mono-dom-good">DOM: Header<br/>DOM: Main<br/>DOM: Footer<br/><br/>Matches visual order</div>
</div>
</div>
<div class="verdict-col">
<span class="verdict-label label-bad"><Icon name="X" size={13} class="ux-icon" /> CSS-reordered</span>
<div class="flex-box-bad">
<div class="mono-dom-bad">DOM: Footer<br/>DOM: Main<br/>DOM: Header<br/><br/>CSS order: 3 1 2</div>
</div>
</div>
</div>
</UxCard>
