---
import UxCard from "../UxCard.astro";
import { Check, X } from "lucide-astro";
---

<UxCard
  id="P-12"
  domain="Privacy"
  domainClass="p-p"
  title=`Drop Unused Fields<br/>Before Launch.`
  rule=`<strong>Store the least data you can.</strong> Drop unused fields before launch, not after a breach. Data minimization is a design decision, not a cleanup task.`
>
<div class="bad-good-row p12-visual">
<div class="verdict-col">
<span class="verdict-label label-bad"><X size={13} class="ux-icon" /> Ship with cruft</span>
<div class="vis-box-bad" style="padding:7px;">
<div class="text-xxs-gray">18 columns, 6 unused</div>
<div class="text-xxs-muted-mt">Breached → all exposed</div>
</div>
</div>
<div class="verdict-col">
<span class="verdict-label label-good"><Check size={13} class="ux-icon" /> Trim pre-launch</span>
<div class="vis-box-good" style="padding:7px;">
<div class="text-xxs-gray">12 columns, all used</div>
<div class="text-xxs-muted-mt">Smaller blast radius</div>
</div>
</div>
</div>
</UxCard>
