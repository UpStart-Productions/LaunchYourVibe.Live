---
import UxCard from "../UxCard.astro";
---

<UxCard
  id="I-11"
  domain="Interaction"
  domainClass="d-i"
  title=`Progress: Show<br/>Where They Are`
  rule=`<strong>Progress without context is just anxiety.</strong> Show step number, percentage, or time estimate. Giving users a frame of reference reduces perceived wait time by 40%.`
>
<div class="fc-7 i11-visual">
<div class="vis-box">
<div class="vis-label">Steps: clear location</div>
<div class="i11-steps">
<div class="i11-step i11-step-1 avatar-orange">1</div>
<div class="bar-connector i11-connector"></div>
<div class="i11-step i11-step-2 avatar-orange">2</div>
<div class="divider-h-plain i11-connector"></div>
<div class="i11-step i11-step-3 avatar-gray">3</div>
<div class="divider-h-plain i11-connector"></div>
<div class="i11-step i11-step-4 avatar-gray">4</div>
</div>
</div>
<div class="vis-box">
<div class="vis-label">Upload: % with estimate</div>
<div class="progress-track-i11"><div class="i11-progress-fill progress-fill"></div></div>
<div class="mono-pct-spread"><span class="i11-pct">42%</span><span class="i11-eta">~18s left</span></div>
</div>
</div>
</UxCard>