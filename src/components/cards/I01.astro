---
import UxCard from "../UxCard.astro";
---

<UxCard
  id="I-01"
  domain="Interaction"
  domainClass="d-i"
  title=`Every Button Needs<br/>4 States. Minimum.`
  rule=`<strong>Missing a state isn't neutral.</strong> No disabled state feels broken when nothing happens. Each state signals what's possible right now.`
>
<div class="states-grid i01-visual">
<div class="state-box"><span class="state-label">Default</span><div class="btn-state btn-default">Save</div></div>
<div class="state-box"><span class="state-label">Hover</span><div class="btn-state btn-hover">Save</div></div>
<div class="state-box"><span class="state-label">Active</span><div class="btn-state btn-active">Save</div></div>
<div class="state-box"><span class="state-label">Disabled</span><div class="btn-state btn-disabled">Save</div></div>
</div>
</UxCard>
