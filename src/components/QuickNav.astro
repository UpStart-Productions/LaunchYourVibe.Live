---
interface NavItem {
  label: string;
  href: string;
  icon: any;
}

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
---

<nav
  class="sticky top-[57px] z-40 border-b border-cosmic bg-cosmic-light/95 py-3 backdrop-blur-md md:top-[65px]"
>
  <div class="container mx-auto px-4">
    <div class="scrollbar-hide flex items-center gap-5 overflow-x-auto md:gap-6">
      {
        items.map((item) => (
          <a
            href={item.href}
            class="flex items-center gap-1.5 whitespace-nowrap text-sm text-muted-cosmic transition-colors hover:text-white"
          >
            <item.icon size={16} />
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
</nav>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>
