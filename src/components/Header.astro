---
import { SITE } from "../config/site";
---

<header class="sticky top-0 z-50 border-b border-cosmic bg-cosmic/95 backdrop-blur-md">
  <div class="container mx-auto flex items-center gap-3 px-4 py-3 md:py-4">
    <a href="/" class="flex items-center gap-3">
      <img src="/images/logo.svg" alt="" class="w-10 md:w-11" />
      <span class="text-lg font-semibold tracking-tight text-white md:text-xl">
        {SITE.name}
      </span>
    </a>
  </div>
</header>
