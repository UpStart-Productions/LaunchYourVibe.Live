---
import { SITE } from "../config/site";
---

<header class="site-header sticky top-0 z-50 bg-cosmic" data-site-header>
  <div class="container mx-auto flex items-center justify-between gap-3 px-4 py-3 md:py-4">
    <a href="/" class="flex items-center gap-3">
      <img src="/images/logo.svg" alt="" class="w-10 md:w-11" />
      <span class="hidden text-lg font-semibold tracking-tight text-white md:inline md:text-xl">
        {SITE.name}
      </span>
    </a>
    <a
      href={SITE.upstartUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="shrink-0 opacity-90 transition-opacity hover:opacity-100"
      aria-label="UpStart Productions"
    >
      <img src="/images/upstart-logo.svg" alt="UpStart Productions" class="h-7 md:h-8" />
    </a>
  </div>
</header>
