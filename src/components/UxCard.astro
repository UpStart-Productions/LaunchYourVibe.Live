---
import { cardPermalink } from "../config/cards";
import { SITE } from "../config/site";
import Icon from "./icons/Icon.astro";

interface Props {
  id: string;          // e.g. "T-01"
  domain: string;      // e.g. "Spacing & Typography"
  domainClass: string; // e.g. "d-t"
  title: string;
  rule: string;
  showPermalink?: boolean;
}

const { id, domain, domainClass, title, rule, showPermalink = true } = Astro.props;

const siteOrigin = Astro.site ?? Astro.url;
const permalink = cardPermalink(id, siteOrigin);

const sectionByDomain: Record<string, string> = {
  "Spacing & Typography": "spacing-typography",
  Interaction: "interaction",
  Components: "components",
  Navigation: "navigation",
  Accessibility: "accessibility",
  Data: "data",
  Security: "security",
  Privacy: "privacy",
};

const stripHtml = (html: string) => html.replace(/<[^>]*>/g, " ");
const searchText = [id, domain, stripHtml(title), stripHtml(rule)]
  .join(" ")
  .toLowerCase();
const sectionId = sectionByDomain[domain] ?? "";
---

<div
  class="card-wrap"
  data-card-id={id}
  data-section={sectionId}
  data-search={searchText}
>
  <div class="card-inner">
    <div class="card-front">
      <div class={`card-header ${domainClass}`}>
        <span class="domain-tag">{domain}</span>
        <span class="card-number">{id}</span>
      </div>
      <div class="card-title" set:html={title} />
      <div class="card-visual">
        <slot />
      </div>
      {
        showPermalink && (
          <div class="card-front-footer">
            <span class="card-copy-feedback" aria-live="polite">Card Link Copied</span>
            <button
              type="button"
              class="card-copy-link"
              data-no-flip
              data-permalink={permalink}
              aria-label="Copy link to this card"
            >
              <Icon name="Link2" size={14} class="card-copy-link-icon ux-icon" />
            </button>
          </div>
        )
      }
    </div>
    <div class="card-back">
      <div class={`back-header ${domainClass}`}>
        <span class="back-brand">LaunchYourVibe</span>
        <span class="back-num">{id}</span>
      </div>
      <div class="back-rule" set:html={rule} />
      <div class="back-footer">
        <span class="back-footer-brand">{SITE.name}</span>
        <a
          href={SITE.upstartUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="back-footer-logo-link"
          data-no-flip
          aria-label="UpStart Productions"
        >
          <img src="/images/upstart-logo.svg" alt="" class="back-footer-logo" />
        </a>
      </div>
    </div>
  </div>
</div>
