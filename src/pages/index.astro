        </div>
      </div>
    </section>

    <SearchBar categories={sectionNavItems} />

    <section class="py-16">
      <div class="container mx-auto px-4">
        <div id="spacing-typography" class="ux-domain-section scroll-mt-[148px] md:scroll-mt-[156px]">
