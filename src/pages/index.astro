<style is:global>
  .ux-domain-label {
    color: #8b86a0;
  }

  .card-wrap--hidden {
    display: none !important;
  }

  .ux-domain-section--hidden {
    display: none !important;
  }
</style>

<script>
  /** T-01 intro flip: show users cards are clickable to reveal the rule on back. */
  (function initT01FlipDemo() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const card = document.querySelector('[data-card-id="T-01"]');
    if (!card) return;

    const FLIP_MS = 550;
    const HOLD_MS = 3000;
    const START_DELAY = 900;
    const timers: ReturnType<typeof setTimeout>[] = [];
    let cancelled = false;

    function later(fn: () => void, ms: number) {
      timers.push(setTimeout(fn, ms));
    }

    function cancel() {
      cancelled = true;
      timers.forEach(clearTimeout);
      timers.length = 0;
    }

    function onUserClick() {
      cancel();
      card.removeEventListener("click", onUserClick);
    }

    card.addEventListener("click", onUserClick);

    later(() => {
      if (cancelled) return;
      card.classList.add("flipped");
      later(() => {
        if (cancelled) return;
        card.classList.remove("flipped");
        card.removeEventListener("click", onUserClick);
      }, FLIP_MS + HOLD_MS);
    }, START_DELAY);
  })();
</script>
