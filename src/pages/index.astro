  { label: "Spacing & Typography", href: "#spacing-typography", icon: "Type" },
  { label: "Interaction", href: "#interaction", icon: "MousePointerClick" },
  { label: "Components", href: "#components", icon: "LayoutGrid" },
  { label: "Navigation", href: "#navigation", icon: "Compass" },
