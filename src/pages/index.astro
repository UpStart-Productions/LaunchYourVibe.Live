  description="Browse 90 UX reference cards across 6 domains. Built for non-developer vibe coders who want to ship good, accessible, secure software."
>
  <Header />

  <main>
    <section class="py-10 md:py-12">
      <div class="container mx-auto px-4">
        <div class="mx-auto max-w-4xl">
          <div class="flex flex-col items-center gap-6 md:flex-row md:items-center md:justify-center md:gap-10">
