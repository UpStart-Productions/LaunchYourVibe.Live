---
import "../../styles/ux-deck.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardDeckScripts from "../../components/CardDeckScripts.astro";
import { CARD_BY_SLUG, CARDS } from "../../config/cards";
import { SITE } from "../../config/site";
import { cardPageDescription, cardPageTitle } from "../../utils/card-seo";

export function getStaticPaths() {
  return CARDS.map((card) => ({ params: { id: card.slug } }));
}

const { id } = Astro.params;
const card = CARD_BY_SLUG[id!];

const CardComponent = card.component;
const pageTitle = cardPageTitle(card, SITE.name);
const pageDescription = cardPageDescription(card, SITE.name);
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="card-single-page">
    <div class="card-single-stage">
      <CardComponent />
    </div>
  </main>

  <CardDeckScripts />
</BaseLayout>

<style>
  .card-single-page {
    display: flex;
    min-height: 100dvh;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 2rem 1rem 3rem;
  }

  .card-single-stage {
    display: flex;
    justify-content: center;
  }
</style>
